# Copy to config.env and edit. Fake values only in the example.

# Public product source (no secrets there)
PUBLIC_GIT_URL="https://github.com/jcdr/puretone.git"
PUBLIC_GIT_REF="main"

# Must match public Cargo android package metadata
ANDROID_APPLICATION_ID="com.jcdr.puretone"
ANDROID_APP_LABEL="Pure Tone"
ANDROID_APK_NAME="PureTone"

# Optional local override of public clone location (relative to vault root)
WORK_DIR="work/puretone"
OUT_DIR="out"
