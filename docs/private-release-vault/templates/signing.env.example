# Copy to signing.env and edit. chmod 600 signing.env
# NEVER commit real passwords to a public remote.

UPLOAD_KEYSTORE_FILE="upload.keystore"
UPLOAD_KEY_ALIAS="upload"
UPLOAD_STORE_PASSWORD="CHANGE_ME_STORE_PASSWORD"
UPLOAD_KEY_PASSWORD="CHANGE_ME_KEY_PASSWORD"

# Certificate subject for a new upload keystore
CERT_CN="Pure Tone"
CERT_OU="Release"
CERT_O="jcdr"
CERT_L="CHANGE_ME_CITY"
CERT_ST="CHANGE_ME_REGION"
CERT_C="CH"
CERT_VALIDITY_DAYS="10000"
